{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emma:lesson-archive:1",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "learner_id",
    "actor_kind",
    "learner_first_name",
    "plugin_version",
    "rules_revision",
    "started_at",
    "ended_at",
    "timezone",
    "transcript_coverage",
    "metrics",
    "summary",
    "materials",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{8,100}$"
    },
    "learner_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{3,80}$"
    },
    "actor_kind": {
      "enum": [
        "learner",
        "parent_test"
      ]
    },
    "learner_first_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "plugin_version": {
      "type": "string"
    },
    "rules_revision": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "timezone": {
      "const": "America/Chicago"
    },
    "transcript_coverage": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    },
    "metrics": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "materials": {
      "type": "array"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "text"
        ],
        "properties": {
          "role": {
            "enum": [
              "learner",
              "coach"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "archive_revision": {
      "type": "integer",
      "minimum": 1
    },
    "session_status": {
      "enum": [
        "active",
        "paused",
        "closed"
      ]
    },
    "practice_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
